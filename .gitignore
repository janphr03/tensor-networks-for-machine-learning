# ------------------------------------------------------------
# Lokale Konfiguration, Zugangsdaten und private Schlüssel
# Beispiele dürfen versioniert werden; diese Datei entfernt
# keine Dateien, die bereits in Git aufgenommen wurden.
# ------------------------------------------------------------
.env
.env.*
!.env.example
!.env.sample
*.local
*.local.json
*.local.toml
*.local.yaml
*.local.yml
/secrets/
/credentials/
/.aws/
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519

