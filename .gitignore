# ------------------------------------------------------------
*.log
/logs/
/.cache/
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# ------------------------------------------------------------
# Hilfswerkzeuge: Python/Jupyter, falls später lokal verwendet
