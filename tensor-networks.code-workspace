{
  "folders": [
    { "path": "." }
  ],
  "settings": {
    "[typst]": {
      "editor.defaultFormatter": "myriad-dreamin.tinymist",
      "editor.formatOnSave": true,
      "editor.wordWrap": "on"
    },
    "tinymist.formatterMode": "typstyle",
    "tinymist.rootPath": "${workspaceFolder}",
    "tinymist.typstExtraArgs": ["thesis.typ"],
    "tinymist.exportPdf": "never",
    "tinymist.preview.refresh": "onSave",
    "terminal.integrated.env.windows": {
      "PATH": "${workspaceFolder}\\.tools\\typst;${env:PATH}"
    },
    "files.exclude": {
      "**/.tools": true
    }
  },
  "extensions": {
    "recommendations": ["myriad-dreamin.tinymist"]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Thesis: Build PDF",
        "type": "process",
        "command": "${workspaceFolder}/.tools/typst/typst.exe",
        "args": [
          "compile", "--root", "${workspaceFolder}",
          "${workspaceFolder}/thesis.typ", "${workspaceFolder}/thesis.pdf"
        ],
        "options": { "cwd": "${workspaceFolder}" },
        "group": { "kind": "build", "isDefault": true },
        "problemMatcher": []
      }
    ]
  }
}
