{
  "folders": [
    { "path": "." }
  ],
  "settings": {
    "[typst]": {
      "editor.defaultFormatter": "myriad-dreamin.tinymist",
      "editor.formatOnSave": true,
      "editor.wordWrap": "on"
    },
    "tinymist.formatterMode": "typstyle",
    "tinymist.rootPath": "${workspaceFolder}",
    "tinymist.exportPdf": "never",
    "terminal.integrated.env.windows": {
      "PATH": "${workspaceFolder}\\.tools\\typst;${env:PATH}"
    },
    "files.exclude": {
      "**/.tools": true
    }
  },
  "extensions": {
    "recommendations": ["myriad-dreamin.tinymist"]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Studienarbeit: PDF erstellen",
        "type": "process",
        "command": "powershell.exe",
        "args": [
          "-NoProfile", "-ExecutionPolicy", "Bypass", "-File",
          "${workspaceFolder}/scripts/build.ps1"
        ],
        "options": { "cwd": "${workspaceFolder}" },
        "group": { "kind": "build", "isDefault": true },
        "problemMatcher": []
      }
    ]
  }
}
